# Bloc Caddy à AJOUTER au Caddyfile existant de Cycymulator
# (/srv/cycymulator/deploy/hetzner/Caddyfile) puis recharger Caddy avec :
#   cd /srv/cycymulator/deploy/hetzner
#   docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
#
# Caddy va automatiquement obtenir un certificat Let's Encrypt pour
# universe3d.duckdns.org (à condition que le DNS pointe sur l'IP du VPS).
#
# /api/* est routé vers l'API stats/admin (universe3d-api:8000), le reste
# vers le frontend statique (universe3d:80) — même origine, pas de CORS.

universe3d.duckdns.org {
    handle /api/* {
        reverse_proxy universe3d-api:8000
    }
    handle {
        reverse_proxy universe3d:80
    }
    encode gzip zstd
    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
