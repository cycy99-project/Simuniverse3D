# Copier en .env (jamais commité) et remplir les valeurs.
# install.sh génère ces secrets automatiquement au premier bootstrap.

# Mot de passe de connexion à /admin.html (dashboard fréquentation)
ADMIN_PASSWORD=change-me-strong-password

# Clé de signature du cookie de session admin
SECRET_KEY=change-me-32-bytes-base64
